
import os, json
from pathlib import Path

# —— CONFIG ——————————————————————————————————————————————
PROJECT_ROOT = Path.cwd()
IMG_ROOT     = PROJECT_ROOT / "data" / "Images_Split"
JSON_PATH    = PROJECT_ROOT / "data" / "annotations_clean.json"
LBL_ROOT     = PROJECT_ROOT / "data" / "labels_yolo_split"

COARSE = [
    "Bottle", "Carton", "Bottle cap", "Can", "Cup",
    "Plastic bag & wrapper", "Other plastic", "Cigarette",
]
coarse_to_fine = {
    "Bottle": ["Other plastic bottle","Clear plastic bottle","Glass bottle"],
    "Carton": ["Other carton","Egg carton","Drink carton","Corrugated carton","Meal carton","Pizza box"],
    "Bottle cap": ["Plastic bottle cap","Metal bottle cap"],
    "Can": ["Drink can","Food Can","Aerosol"],
    "Cup": ["Paper cup","Disposable plastic cup","Foam cup","Glass cup","Other plastic cup"],
    "Plastic bag & wrapper": ["Single-use carrier bag","Polypropylene bag","Garbage bag","Other plastic wrapper","Crisp packet","Plastic film"],
    "Other plastic": ["Other plastic","Other plastic container","Plastic utensils","Plastic glooves","Tupperware","Disposable food container","Foam food container","Spread tub"],
    "Cigarette": ["Cigarette"],
}
# ————————————————————————————————————————————————————————

def main():
    # Load JSON
    coco = json.loads(JSON_PATH.read_text())

    # Build lookups
    name2id = {c["name"]: c["id"] for c in coco["categories"]}
    cat2new = {}
    for new_idx, coarse in enumerate(COARSE):
        for fine in coarse_to_fine[coarse]:
            oid = name2id.get(fine)
            if oid is None:
                raise ValueError(f"Missing category '{fine}'")
            cat2new[oid] = new_idx

    # Ensure label root exists
    # We'll mirror the Images_Split structure
    for split in ("train","val","test"):
        # scan images to find all subfolders
        for img_file in (IMG_ROOT / split).rglob("*.*"):
            rel = img_file.relative_to(IMG_ROOT / split)   # e.g. batch_3/IMG_5057.JPG
            out_folder = LBL_ROOT / split / rel.parent
            out_folder.mkdir(parents=True, exist_ok=True)

    # Process each image in JSON
    for img in coco["images"]:
        rel = Path(img["file_name"])
        # Try both possible splits
        for split in ("train","val","test"):
            img_path = IMG_ROOT / split / rel
            if img_path.exists():
                # Found the file under this split
                w,h = img["width"], img["height"]
                lines = []
                for ann in coco["annotations"]:
                    if ann["image_id"] != img["id"]:
                        continue
                    new_idx = cat2new.get(ann["category_id"])
                    if new_idx is None:
                        continue
                    x,y,bw,bh = ann["bbox"]
                    xc = (x + bw/2) / w
                    yc = (y + bh/2) / h
                    lines.append(f"{new_idx} {xc:.6f} {yc:.6f} {bw/w:.6f} {bh/h:.6f}")
                if not lines:
                    break  # no relevant anns; skip writing
                out_path = LBL_ROOT / split / rel.parent / f"{rel.stem}.txt"
                out_path.write_text("\n".join(lines))
                break  # done with this image

    print("✅ Labels generated under data/labels_yolo_split/train|val|test")

if __name__ == "__main__":
    main()
